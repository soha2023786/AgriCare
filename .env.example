# Required for farmer registration/login. Generate once and keep stable across deployments.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AGRICARE_AUTH_SECRET=replace-with-a-long-random-secret

# Production (Vercel): use a managed PostgreSQL connection string (Neon/Supabase/etc.).
# Use the provider's pooled/runtime URL where available; require TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Local development only: SQLite is stored in the project folder, not /tmp.
# AGRICARE_DB_PATH=./app/agricare.db

# Optional AI and crop-image provider credentials; never put these in frontend files.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PLANTNET_API_KEY=
DATA_GOV_IN_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
